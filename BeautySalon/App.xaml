<Application x:Class="BeautySalon.App"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:BeautySalon.Converters"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="AccentBrush"    Color="#FFFF4A6D"/>
        <SolidColorBrush x:Key="SecondaryBrush" Color="#FFE1E4FF"/>
        <SolidColorBrush x:Key="DiscountBrush"  Color="#FFDDFFDD"/>

        <conv:PathToImageConverter            x:Key="PathToImage"/>
        <conv:BoolToStrikethroughConverter    x:Key="BoolToStrike"/>
        <conv:BoolToVisibilityConverter       x:Key="BoolToVis"/>

        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Icon"       Value="/Resoursces/beauty_logo.ico"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Tahoma"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="Padding"    Value="12,6"/>
            <Setter Property="Cursor"     Value="Hand"/>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background"      Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="SecondaryPanel" TargetType="Border">
            <Setter Property="Background"   Value="{StaticResource SecondaryBrush}"/>
            <Setter Property="Padding"      Value="10"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
    </Application.Resources>
</Application>