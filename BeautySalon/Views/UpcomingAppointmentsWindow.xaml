<Window x:Class="BeautySalon.Views.UpcomingAppointmentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ближайшие записи (сегодня и завтра)"
        Height="560" Width="1000"
        MinHeight="420" MinWidth="820"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Image Source="/Resoursces/beauty_logo.png"
                   Width="32" Height="32" Margin="0,0,8,0"/>
            <TextBlock Text="Ближайшие записи" FontSize="18" FontWeight="Bold"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="lblUpdated" Margin="16,0,0,0"
                       VerticalAlignment="Center" Foreground="#FF777777"/>
        </StackPanel>

        <DataGrid x:Name="dgAppointments" Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  AlternatingRowBackground="#FFF7F7FF"
                  RowHeight="34">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsUrgent}" Value="True">
                            <Setter Property="Foreground" Value="Red"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Услуга" Binding="{Binding ServiceTitle}" Width="*"/>
                <DataGridTextColumn Header="Клиент" Binding="{Binding ClientFullName}" Width="200"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="180"/>
                <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="140"/>
                <DataGridTextColumn Header="Дата и время"
                                    Binding="{Binding StartTime, StringFormat='dd.MM.yyyy HH:mm'}"
                                    Width="140"/>
                <DataGridTextColumn Header="Осталось"
                                    Binding="{Binding RemainingTime}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" Margin="0,8,0,0"
                   Foreground="#FF777777"
                   Text="Окно автоматически обновляется каждые 30 секунд."/>
    </Grid>
</Window>