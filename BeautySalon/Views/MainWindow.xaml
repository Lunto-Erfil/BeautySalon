<Window x:Class="BeautySalon.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Бархатные бровки — Услуги салона"
        Height="720" Width="1150"
        MinHeight="600" MinWidth="950"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Image Source="/Resoursces/beauty_logo.png"
                   Width="40" Height="40" Margin="0,0,10,0"/>
            <TextBlock Text="Бархатные бровки" FontSize="22" FontWeight="Bold"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource SecondaryPanel}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="txtSearch" Grid.Column="0"
                         Padding="6,4" VerticalContentAlignment="Center"
                         TextChanged="TxtSearch_TextChanged"
                         ToolTip="Поиск по названию и описанию услуги"/>

                <TextBlock Grid.Column="1" Text="Скидка:"
                           VerticalAlignment="Center" Margin="12,0,6,0"/>

                <ComboBox x:Name="cmbDiscount" Grid.Column="2" Width="160"
                          SelectionChanged="CmbDiscount_SelectionChanged">
                    <ComboBoxItem Content="Все"/>
                    <ComboBoxItem Content="от 0 до 5%"/>
                    <ComboBoxItem Content="от 5% до 15%"/>
                    <ComboBoxItem Content="от 15% до 30%"/>
                    <ComboBoxItem Content="от 30% до 70%"/>
                    <ComboBoxItem Content="от 70% до 100%"/>
                </ComboBox>

                <StackPanel Grid.Column="3" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="16,0">
                    <TextBlock Text="Цена:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <RadioButton x:Name="rbAsc" Content="↑" IsChecked="True"
                                 GroupName="Sort" Checked="RbSort_Checked"
                                 VerticalAlignment="Center"/>
                    <RadioButton x:Name="rbDesc" Content="↓" Margin="8,0,0,0"
                                 GroupName="Sort" Checked="RbSort_Checked"
                                 VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="4" x:Name="btnAdmin"
                        Content="Режим администратора"
                        Style="{StaticResource AccentButton}"
                        Click="BtnAdmin_Click"/>
            </Grid>
        </Border>

        <DataGrid x:Name="dgServices" Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="#FFF7F7FF"
                  SelectionMode="Single"
                  RowHeight="70">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasDiscount}" Value="True">
                            <Setter Property="Background" Value="{StaticResource DiscountBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Фото" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Source="{Binding MainImagePath,
                                            Converter={StaticResource PathToImage}}"
                                   Width="60" Height="60" Stretch="Uniform"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Услуга" Binding="{Binding Title}"
                                    Width="*" MinWidth="180"/>

                <DataGridTemplateColumn Header="Цена" Width="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Cost, StringFormat={}{0:N2} ₽}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding FinalCost, StringFormat={}{0:N2} ₽}"
                                           Margin="8,0,0,0" FontWeight="Bold"
                                           Foreground="#FFB30000"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding HasDiscount,
                                                Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Длительность"
                                    Binding="{Binding DurationMinutes, StringFormat={}{0} мин}"
                                    Width="130"/>

                <DataGridTextColumn Header="Скидка"
                                    Binding="{Binding Discount, StringFormat={}{0:0.#}%}"
                                    Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="lblCount" Grid.Row="3" Margin="4,8,0,0"
                   Foreground="#FF555555"/>

        <StackPanel x:Name="pnlAdmin" Grid.Row="4" Orientation="Horizontal"
                    Margin="0,10,0,0" Visibility="Collapsed">
            <Button Content="Добавить" Width="120" Margin="0,0,8,0" Click="BtnAdd_Click"/>
            <Button Content="Редактировать" Width="140" Margin="0,0,8,0" Click="BtnEdit_Click"/>
            <Button Content="Удалить" Width="120" Margin="0,0,8,0" Click="BtnDelete_Click"/>
            <Button Content="Записать клиента" Width="170" Margin="0,0,8,0" Click="BtnAppointment_Click"/>
            <Button Content="Ближайшие записи" Width="170" Click="BtnUpcoming_Click"/>
        </StackPanel>
    </Grid>
</Window>