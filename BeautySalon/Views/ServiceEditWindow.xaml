<Window x:Class="BeautySalon.Views.ServiceEditWindow"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Услуга"
        Height="640" Width="720"
        MinHeight="560" MinWidth="640"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Image Source="/Resoursces/beauty_logo.png"
                   Width="32" Height="32" Margin="0,0,8,0"/>
            <TextBlock x:Name="lblHeader" Text="Услуга"
                       FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="Название"/>
                <TextBox x:Name="txtTitle" Margin="0,2,0,10" Padding="6"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="Стоимость, ₽"/>
                        <TextBox x:Name="txtCost" Margin="0,2,0,10" Padding="6"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock Text="Длительность, мин (до 240)"/>
                        <TextBox x:Name="txtDuration" Margin="0,2,0,10" Padding="6"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Скидка, %"/>
                <TextBox x:Name="txtDiscount" Margin="0,2,0,10" Padding="6"/>

                <TextBlock Text="Описание"/>
                <TextBox x:Name="txtDescription" Margin="0,2,0,10"
                         Padding="6" MinHeight="120"
                         AcceptsReturn="True" TextWrapping="Wrap"/>

                <TextBlock Text="Основное изображение"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Border BorderBrush="#FFCCCCCC" BorderThickness="1" Width="110" Height="110">
                        <Image x:Name="imgMain" Stretch="Uniform"/>
                    </Border>
                    <Button Content="Выбрать…" Margin="10,0,0,0"
                            VerticalAlignment="Top" Click="BtnChooseMain_Click"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1">
                <TextBlock Text="Дополнительные изображения"/>
                <ListBox x:Name="lstPhotos" Height="260" Margin="0,4,0,8"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#FFCCCCCC" BorderThickness="1"
                                    Margin="2" Padding="2">
                                <StackPanel>
                                    <Image Source="{Binding PhotoPath, Converter={StaticResource PathToImage}}"
                                           Width="80" Height="80" Stretch="Uniform"/>
                                    <Button Content="Удалить" FontSize="10"
                                            Margin="0,4,0,0"
                                            Click="BtnRemovePhoto_Click"
                                            Tag="{Binding}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button Content="Добавить изображение…" Click="BtnAddPhoto_Click"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Отмена" Width="120" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Сохранить" Width="120"
                    Style="{StaticResource AccentButton}"
                    IsDefault="True" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>